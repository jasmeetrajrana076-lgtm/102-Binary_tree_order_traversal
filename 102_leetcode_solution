class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {
        queue<TreeNode*>q;
        if(root == NULL) return {};

        q.push(root);
        
        TreeNode* temp;
        vector<vector<int>>result;
        while(!q.empty())
        {
            vector<int>ans;
            int size = q.size();
            for(int i=0;i<size;i++)
            {
                temp = q.front();
                q.pop();
                ans.push_back(temp->val);
                if(temp->left!=NULL) q.push(temp->left);
                if(temp->right!=NULL) q.push(temp->right);
            }
            result.push_back(ans);
        }
        return result;
    }
};
